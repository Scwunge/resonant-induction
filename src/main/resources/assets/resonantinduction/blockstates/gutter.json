{
  "multipart": [
    {
      "when": {
        "down": "false"
      },
      "apply": {
        "model": "resonantinduction:block/gutter_base"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "resonantinduction:block/gutter_side",
        "y": 0
      }
    },
    {
      "when": {
        "OR": [
          {
            "east": "false"
          },
          {
            "south": "false"
          }
        ]
      },
      "apply": {
        "model": "resonantinduction:block/gutter_corner",
        "y": 0
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "resonantinduction:block/gutter_side",
        "y": 90
      }
    },
    {
      "when": {
        "OR": [
          {
            "south": "false"
          },
          {
            "west": "false"
          }
        ]
      },
      "apply": {
        "model": "resonantinduction:block/gutter_corner",
        "y": 90
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "resonantinduction:block/gutter_side",
        "y": 180
      }
    },
    {
      "when": {
        "OR": [
          {
            "west": "false"
          },
          {
            "north": "false"
          }
        ]
      },
      "apply": {
        "model": "resonantinduction:block/gutter_corner",
        "y": 180
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "resonantinduction:block/gutter_side",
        "y": 270
      }
    },
    {
      "when": {
        "OR": [
          {
            "north": "false"
          },
          {
            "east": "false"
          }
        ]
      },
      "apply": {
        "model": "resonantinduction:block/gutter_corner",
        "y": 270
      }
    }
  ]
}
