{
  "multipart": [
    {
      "apply": {
        "model": "resonantinduction:block/electromagnet_glass"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "resonantinduction:block/edge/atomic"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "resonantinduction:block/edge/atomic",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "resonantinduction:block/edge/atomic",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "resonantinduction:block/edge/atomic",
        "y": 270
      }
    },
    {
      "when": {
        "up": "false"
      },
      "apply": {
        "model": "resonantinduction:block/edge/atomic",
        "x": 270
      }
    },
    {
      "when": {
        "down": "false"
      },
      "apply": {
        "model": "resonantinduction:block/edge/atomic",
        "x": 90
      }
    }
  ]
}
